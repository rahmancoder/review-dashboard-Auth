model Feedback {
    id String @id @default(uuid())

    decision  SubmissionStatus
    comment   String?
    createdAt DateTime         @default(now())

    // relation 
    sumbissionId String

    submission Submission @relation(fields: [sumbissionId], references: [id], onDelete: Cascade)

    mentorId String
    mentor   User   @relation("MentorFeedbacks", fields: [mentorId], references: [id], onDelete: Restrict)

    @@index([sumbissionId, createdAt(sort: Desc)])
    @@index([mentorId])
}
