model User {
    id    String @id @default(uuid())
    name  String
    email String @unique

    passwordHash String

    role Role @default(STUDENT)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    /// 1 User (student)  -> N Submissions
    submissions Submission[] @relation("StudentSubmissions")

    /// 1 User (mentor)   -> N Feedback entries they wrote
    feedbacks Feedback[] @relation("MentorFeedbacks")

    /// 1 User (mentor)   -> N Submissions they reviewed (latest decision)
    reviewed Submission[] @relation("SubmissionReviewer")

    @@index([role])
}
