model User {
    id           String @id @default(uuid())
    name         String
    email        String @unique
    passwordHash String

    role Role @default(STUDENT)

    // relation Submission, Feedback
    // 1 User (Student) N Submission
    submissions Submission[] @relation("StudentSubmission")

    // 1 reviewer can send N reviewed
    reviewed Submission[] @relation("ReviewerSubmission")

    // relation to Feedback 1 Mentor can give N feedback

    feedbacks Feedback[] @relation("MentorFeedbacks")

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    @@index([role])
}
