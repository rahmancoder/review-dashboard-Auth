model Submission {
    id String @id @default(uuid())

    projectName String
    repoURL     String
    liveURL     String
    description String

    status  SubmissionStatus @default(PENDING)
    repoKey String           @unique

    // relation
    studentId String
    student   User   @relation("StudentSubmission", fields: [studentId], references: [id], onDelete: Cascade)

    // reviewer
    reviewerId String?
    reviewer   User?     @relation("ReviewerSubmission", fields: [reviewerId], references: [id], onDelete: SetNull)
    reviewesAt DateTime?

    // Feedback History
    feedbacks Feedback[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status, createdAt(sort: Desc)])
    @@index([studentId, createdAt(sort: Desc)])
}
